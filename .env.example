# =========================================================================
# HandoffLedger Environment Configuration
# =========================================================================

# Application
PORT=8000
DATABASE_URL=sqlite:///./handoff_ledger.db
DEFAULT_LEAVER_NAME="Alice Maintainer"

# NVIDIA NIM / Nemotron Ultra 550B LLM Integration
